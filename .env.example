# Leitura manual (botão "Ler agora" / node bin/ler.mjs) e gasto
# BALDE_LLM_MODELO=gpt-4.1-nano           # o mais barato por padrão
# BALDE_LLM_LIMITE_DIA_USD=0.50           # teto diário: acima disso grava sem chamar o LLM
# BALDE_LER_AUDIO=1                       # áudio ligado (whisper local se existir)
# BALDE_TRANSCRICAO_MODELO=gpt-4o-mini-transcribe
# BALDE_LER_IMAGEM=0                      # imagem desligada (marca "📎 não lido")
# BALDE_LER_PDF=0                         # PDF desligado
# BALDE_SERVICO_LABEL=com.balde.servico    # nome do serviço no launchd (macOS)
# BALDE_LEITURA=auto                      # leitura contínua (gasta mais); padrão = manual
